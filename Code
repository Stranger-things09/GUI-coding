#Creates a Combobox pick-list
combo = ttk.Combobox(
    values = ["Visa","Master Card", "American Express", "Cash"],
)
combo.grid(row=15, column=2, sticky=W, pady=(0,10))#Can also use Combo.place function to place it in the window

# Creates a call to function action to take down the choices selected.
def writeToLog():
    if not nameText.get().strip():
        messagebox.showerror("Invalid User Input", "Please enter the customer name")
        return
     
    if not combo.get().strip():
        messagebox.showerror("Invalid User Input", "Please enter a payment type")
        return

    now = datetime.now().strftime("%m/%d/%Y %H:%M %p")
    log = open("orders.txt", "a")
    log.write(f"Customer Name:      {nameText.get()} \n")
    log.write(f"Car Type:           {workOrder.get()} \n")
    log.write(f"Customization Choices: \n")
    
    # Check each variable. If it is 1 (checked), write the name.
    if CPJ.get() == 1:
        log.write("      - Custom Paint Job\n")
    if PT.get() == 1:
        log.write("      - Performance Tires\n")
    if AI.get() == 1:
        log.write("      - Alarm Installation\n")
    if LS.get() == 1:
        log.write("      - Leather Seats\n")
    if CA.get() == 1:
        log.write("      - Custom Audio\n")
    if HTU.get() == 1:
        log.write("      - Headlight/Taillight Upgrades\n")
    if WT.get() == 1:
        log.write("      - Window Tinting\n")
    if SR.get() == 1:
        log.write("      - Sun Roof\n")

    log.write(f"Card: {combo.get()} \n")
    log.write(f"Order Placed At: {now} \n")
    log.write("====================================================================\n\n")
    log.close()

def resetFields():
    nameText.delete(0, END)
    
    btncpj.deselect()
    btnpt.deselect()
    btnai.deselect()
    btnls.deselect()
    btnca.deselect()
    btnhtu.deselect()
    btnwt.deselect()
    btnsr.deselect()

    combo.set("")
    workRaceCar.select()

clear = Button(main_window, text="Clear", command=resetFields)#Calls the function resetFields
submit = Button(main_window, text="Submit", command=writeToLog)#Calls the function writeToLog

submit.grid(row=20, column=1, sticky=E, pady=(10,0))
clear.grid(row=20, column=3, sticky=W, pady=(10,0))

main_window.mainloop()
    

    






















           
